# Telegram Bot Configuration
# ទទួលបាន Token ពី @BotFather ក្នុង Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Timezone (កម្ពុជា)
BOT_TIMEZONE="Asia/Phnom_Penh"

# ម៉ោងសម្រាប់ដាស់តឿនថ្ងៃបុណ្យឈប់សម្រាក (4:00 AM)
ALERT_HOUR=4
ALERT_MINUTE=0

# ទំហំវីដេអូអតិបរមាដែលអាចទាញយកបាន (Telegram Bot standard limit is 50MB)
MAX_FILE_SIZE_MB=50
